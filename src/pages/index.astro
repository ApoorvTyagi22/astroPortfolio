---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import NavBar from '../components/NavBar.jsx';
import TypingAnimation from '../components/TypingAnimation.jsx';
import Skills from '../components/Skills.jsx';
// Note: In Astro, we use regular <img> and <a> tags.
// The Image component is built-in for optimization.
import { Image } from 'astro:assets';
import profilePic from '../../public/images/profile/profilePic.jpg';
--- 
<Layout title="Apoorv's Portfolio" description="A portfolio showcasing web development and machine learning projects.">
  
  <NavBar currentPath="/" client:load />
  
  <!-- Section 1: Hero -->
  <main class="flex items-center text-dark w-full min-h-screen dark:text-light bg-gradient-to-br from-blue-50 via-blue-100 to-blue-200 dark:from-slate-900 dark:via-slate-800 dark:to-slate-700 relative overflow-hidden">
    <!-- Background Pattern -->
    <div class="absolute inset-0 bg-[url('data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iNjAiIGhlaWdodD0iNjAiIHZpZXdCb3g9IjAgMCA2MCA2MCIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj48ZyBmaWxsPSJub25lIiBmaWxsLXJ1bGU9ImV2ZW5vZGQiPjxnIGZpbGw9IiMzMzMiIGZpbGwtb3BhY2l0eT0iMC4wNSI+PGNpcmNsZSBjeD0iMzAiIGN5PSIzMCIgcj0iMSI+PC9jaXJjbGU+PC9nPjwvZz48L3N2Zz4=')] opacity-20"></div>
    
    <div class="pt-0 md:pt-16 sm:pt-8 w-full relative z-10"> 
      <div class="flex items-center justify-center w-full px-32 xl:px-24 lg:px-16 md:px-12 sm:px-8">
        <div class="w-full flex flex-col items-center self-center text-center">
          <TypingAnimation
            className="mb-8"
            client:visible
          />
          <p class="my-4 text-base font-medium md:text-sm sm:text-xs text-slate-700 dark:text-slate-300 max-w-2xl text-center">
            I am a mathematics and computer science student at the University of Southampton with a 
            strong passion for MERN stack development, machine learning and deep learning. I have 
            gained extensive knowledge in these fields through courses and project development.
          </p>
          <div class="flex items-center justify-center mt-2 gap-4">
            <a 
              href="mailto:tyagip872@gmail.com" 
              target="_blank" 
              class="text-lg font-medium text-blue-700 dark:text-blue-400 capitalize underline hover:text-blue-800 dark:hover:text-blue-300 transition-colors md:text-base"
            >
              Contact
            </a>
            <a 
              href="/projects" 
              class="text-lg font-medium text-blue-700 dark:text-blue-400 capitalize underline hover:text-blue-800 dark:hover:text-blue-300 transition-colors md:text-base"
            >
              View projects
            </a>
            <a 
              href="/blog" 
              class="text-lg font-medium text-blue-700 dark:text-blue-400 capitalize underline hover:text-blue-800 dark:hover:text-blue-300 transition-colors md:text-base"
            >
              View Blogs
            </a>
          </div>
        </div>
      </div>
    </div>
  </main>

  <!-- Section 2: About Me & Skills -->
  <main class="flex w-full flex-col items-center justify-center dark:text-light bg-white dark:bg-slate-900 py-24">
    <div class="pt-16 w-full px-32 xl:px-24 lg:px-16 md:px-12 sm:px-8"> 
      <h1 class="mb-16 lg:!text-7xl sm:!text-6xl xs:!text-4xl sm:mb-8 text-center text-slate-800 dark:text-slate-100 font-bold">
        Passion Powers Purpose
      </h1>
      <div class="grid w-full grid-cols-8 gap-16 sm:gap-8">
        <div class="col-span-3 relative h-max rounded-2xl border-2 border-solid border-blue-200 dark:border-blue-600 bg-blue-50 dark:bg-slate-800 p-8 xl:col-span-4 md:order-1 md:col-span-8 shadow-xl">
          <div class="absolute top-0 -right-3 -z-10 w-[102%] h-[103%] rounded-[2rem] bg-blue-200 dark:bg-blue-900"></div>
          <Image src={profilePic} alt="Apoorv Tyagi" class="w-full h-auto rounded-2xl shadow-lg" />
        </div>
        <div class="col-span-5 flex flex-col items-start justify-start xl:col-span-4 md:order-2 md:col-span-8">
          <h2 class="mb-4 text-lg font-bold uppercase text-blue-600 dark:text-blue-400">About Me</h2>
          <p class="font-medium text-slate-700 dark:text-slate-300 mb-4">
            Hi, I am Apoorv Tyagi, a passionate mathematics and computer science student at the University of Southampton. 
            I specialize in full-stack web development using the MERN stack and have a deep interest in machine learning 
            and artificial intelligence.
          </p>
          <p class="my-4 font-medium text-slate-700 dark:text-slate-300">
            On this website, you can find a showcase of my projects, ranging from web applications to machine learning 
            models. I love creating innovative solutions that combine beautiful user interfaces with powerful backend systems.
          </p>
          <p class="font-medium text-slate-700 dark:text-slate-300">
            I look forward to the opportunity to collaborate on exciting projects and contribute to the ever-evolving 
            world of technology. Feel free to explore my work and get in touch!
          </p>
        </div>
      </div>
      <Skills client:visible />
    </div>
  </main>

</Layout>